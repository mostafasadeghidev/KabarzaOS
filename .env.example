# Copy to .env and edit. Every value here is OPTIONAL — the stack starts
# with no .env at all. Set only what you need.
#
# The app reads both .env and .env.prod (install.sh writes .env.prod and
# links .env to it); if both exist, .env.prod wins. Apply changes with
# `docker compose up -d` — a plain restart does not reload them.

# ── Deployment ───────────────────────────────────────────────────────
# Public address. Used in notification links and emails.
APP_URL=https://team.example.com

# Host port. Change this if 3000 is already taken on the server.
# The port inside the container is always 3000 — only the host side moves.
APP_PORT=3000

# Bind address. Default 0.0.0.0 publishes on all interfaces, which is what
# deployment tools expect — their proxy usually runs in another container
# and cannot reach the host's loopback.
# Set 127.0.0.1 to keep it private behind a proxy you run yourself.
BIND=0.0.0.0

APP_TIMEZONE=Asia/Tehran
DEFAULT_LOCALE=fa

# ── Secrets ──────────────────────────────────────────────────────────
# Leave BOTH empty and the container generates them on first boot and
# keeps them in the app_data volume — that is the recommended setup.
#
# Set them only if you want to manage them yourself. Generate with:
#   openssl rand -hex 32
#
# ⚠️ SESSION_SECRET signs session cookies. Changing it later signs
# everyone out. Minimum 32 characters.
SESSION_SECRET=
# ⚠️ CRON_SECRET guards /api/cron/tick. If you set it here, the scheduler
# container uses it too — they must match, and they will.
CRON_SECRET=

# ── Database and storage ─────────────────────────────────────────────
# Both have working internal defaults and neither publishes a port, so
# you can leave these alone. DB_PASSWORD cannot be changed after the
# first boot — Postgres fixes it at initdb.
DB_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kabarza
S3_REGION=us-east-1

# ── External object store (optional) ─────────────────────────────────
# Leave empty to use the bundled MinIO. To use S3, Cloudflare R2, ArvanCloud
# or any S3-compatible store, set S3_ENDPOINT plus the S3_* keys above to
# that store's values — see "Switching the file store" in docs/DEPLOY.md.
S3_ENDPOINT=
# The bundled MinIO's own login. Empty = the S3_* keys above. Before
# pointing S3_* at another store, copy the current S3_ACCESS_KEY and
# S3_SECRET_KEY here, so the old MinIO keeps its login while files are
# copied out of it.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── Email (optional) ─────────────────────────────────────────────────
# Without SMTP_HOST the email channel stays silently off and
# notifications arrive in-app (and via Telegram) only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Telegram (optional) ──────────────────────────────────────────────
# Without a token the Telegram channel and its connect banner are hidden
# entirely. Create a bot with @BotFather to get both values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# How the bot receives messages (commands, buttons, AI chat):
#   auto (default) — webhook when APP_URL is https, polling in production
#                    without https, off in development
#   webhook | polling | off
# Never run polling locally with the production bot token: it would take
# real users' messages away from the live server.
TELEGRAM_BOT_MODE=auto
# Optional: separate secret for encrypting users' AI keys (32+ chars).
# Defaults to SESSION_SECRET. Changing it means users reconnect their AI.
AI_KEY_SECRET=
